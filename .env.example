# Signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
GRAVYBOAT_SECRET_KEY=

# How Gravy Boat reaches Mealie from the server (an internal address is fine).
MEALIE_URL=http://mealie:9000

# How people's browsers reach Mealie, for recipe links and photos. Defaults to MEALIE_URL.
MEALIE_PUBLIC_URL=https://mealie.example.com

# Sign-in needs HTTPS (session cookies are Secure). Only for plain-http testing on a LAN:
# GRAVYBOAT_INSECURE_COOKIES=1

# Optional
# TZ=America/New_York
# GRAVYBOAT_DATABASE_URL=sqlite:////data/gravyboat.db

# How many reverse proxies sit in front of Gravy Boat (their X-Forwarded-* headers are trusted for
# HTTPS detection and client addresses). Set 0 if browsers connect to it directly.
# GRAVYBOAT_TRUSTED_PROXIES=1
